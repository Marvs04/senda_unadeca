############################################################
# SENDA — App (Backend + Frontend) — Variables de entorno
# Copiar a deploy/.env y rellenar los valores
# Generado automáticamente por install.sh
############################################################

# Dominio principal del sistema (sin barra al final)
SITE_URL=https://senda.rlp.lat

# URL pública de la API de Supabase (usada al compilar el frontend)
VITE_SUPABASE_URL=https://sendasupabaseapi.rlp.lat

# Claves de Supabase (copiadas desde supabase/.env por install.sh)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SENDER_NAME=SENDA-Lab
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
