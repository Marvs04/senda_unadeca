# Copiados desde supabase/.env después de ejecutar install.sh
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (mismo que supabase/.env)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
