# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

