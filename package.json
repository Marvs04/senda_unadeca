{
  "name": "senda-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "run-s stop dev:core",
    "dev:core": "concurrently -n backend,frontend -c cyan,magenta \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "npm --prefix frontend run typecheck",
    "stop": "kill-port 3000 3001 3002 4000",
    "restart": "run-s stop dev:core"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "npm-run-all2": "^7.0.2"
  }
}
