############################################################
# SENDA — Infraestructura (nginx + Cloudflare Tunnel)
# Copiar a infra/.env y rellenar los valores
############################################################

# Token del Cloudflare Tunnel
# Crearlo en: https://one.dash.cloudflare.com → Access → Tunnels → Create Tunnel
CF_TUNNEL_TOKEN=

# Credenciales para el panel de Supabase Studio (sendasupabase.rlp.lat)
# Ejecutar: htpasswd -nb <usuario> <contraseña>  → copiar el resultado a infra/.htpasswd_senda
NGINX_HTPASSWD_USER=admin
NGINX_HTPASSWD_PASS=
