# Credenciales para el panel de Supabase Studio (sendasupabase.*)
# El hash se genera automáticamente con install.sh via openssl passwd
# Para generarlo manualmente: openssl passwd -apr1 "tu-contraseña"
NGINX_HTPASSWD_USER=admin
NGINX_HTPASSWD_PASS=
