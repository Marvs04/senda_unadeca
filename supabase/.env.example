############################################################
# SENDA — Supabase self-hosted — Variables de entorno
# Copiar a supabase/.env y rellenar los valores
# Los valores marcados con "# auto" son generados por install.sh
############################################################

############
# Secretos (generados por install.sh o manualmente con openssl)
############

POSTGRES_PASSWORD=          # auto — openssl rand -base64 32
JWT_SECRET=                 # auto — openssl rand -base64 48
ANON_KEY=                   # auto — JWT firmado con JWT_SECRET (role=anon)
SERVICE_ROLE_KEY=           # auto — JWT firmado con JWT_SECRET (role=service_role)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=         # auto — openssl rand -base64 16
SECRET_KEY_BASE=            # auto — openssl rand -base64 48
VAULT_ENC_KEY=              # auto — openssl rand -base64 32
LOGFLARE_PUBLIC_ACCESS_TOKEN=   # auto — openssl rand -hex 40
LOGFLARE_PRIVATE_ACCESS_TOKEN=  # auto — openssl rand -hex 40
PG_META_CRYPTO_KEY=         # auto — openssl rand -base64 32
S3_PROTOCOL_ACCESS_KEY_ID=  # auto — openssl rand -hex 16
S3_PROTOCOL_ACCESS_KEY_SECRET=  # auto — openssl rand -base64 32

############
# URLs — ajustar a tu dominio
############

SITE_URL=https://senda.rlp.lat
API_EXTERNAL_URL=https://sendasupabaseapi.rlp.lat
SUPABASE_PUBLIC_URL=https://sendasupabaseapi.rlp.lat

############
# Base de datos
############

POSTGRES_HOST=senda-db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# JWT
############

JWT_EXPIRY=3600
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

############
# SMTP — para envío de correos de Auth
############

SMTP_ADMIN_EMAIL=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=SENDA-Lab

############
# Auth — comportamiento de registro
############

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ADDITIONAL_REDIRECT_URLS=

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Pooler (Supavisor)
############

POOLER_TENANT_ID=senda
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# Storage
############

GLOBAL_S3_BUCKET=senda-storage
STORAGE_TENANT_ID=senda
REGION=local
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=true

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=SENDA
STUDIO_DEFAULT_PROJECT=senda
OPENAI_API_KEY=
